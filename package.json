{
  "name": "ppl-tracker",
  "private": true,
  "scripts": {
    "build": "npm run build:vendor && npm run build:js && npm run build:css",
    "build:vendor": "mkdir -p vendor && cp node_modules/react/umd/react.production.min.js node_modules/react-dom/umd/react-dom.production.min.js vendor/",
    "build:js": "esbuild src/app.jsx --bundle --format=iife --minify --target=chrome80 --outfile=app.js",
    "build:css": "tailwindcss -i src/styles.css -o app.css --minify"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "tailwindcss": "3.4.19"
  }
}
